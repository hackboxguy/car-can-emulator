# Drive cycle for car-can-emulator --drive-cycle=<file>.
#
# Replicates qt-cluster-demo's built-in demo (DemoSimulator.cpp): 12 phases,
# 44 s, looping. Values interpolate linearly across a phase; lamps are set
# and cleared at the phase boundary. Lines: "key value..." or
#   phase <ms> <speed0> <speed1> <rpm0> <rpm1> <coolant0> <coolant1> <set lamps> <clear lamps>
# where a lamp list is comma-separated names or "-" for none. Lamps:
# engine oil battery brake left right highbeam door seatbelt abs traction tpms
# ev-ready charging limited-power low-traction-battery park-brake low-fuel fog hv-fault
tick_ms 50
fuel_start 75
fuel_end 60
soc_start 80
odometer_start 10568
#      ms   spd0 spd1  rpm0 rpm1  tmp0 tmp1  set             clear
phase  2000    0   40   800 2500    70   75  left,seatbelt   -
phase  2000   40   80  2500 3500    75   80  -               left,seatbelt
phase  3000   80  120  2000 3500    80   85  engine          -
phase  8000  120  120  2500 2500    85   90  highbeam        engine
phase  3000  120  160  2500 4500    90   90  tpms            highbeam
phase  6000  160  160  3200 3200    90   90  abs             tpms
phase  3000  160  200  3200 5500    90   92  traction        abs
phase  4000  200  200  4000 4000    92   92  oil,battery     traction
phase  4000  200   80  4000 1800    92   88  brake           oil,battery
phase  3000   80   40  1800 1200    88   86  right,door      -
phase  3000   40    0  1200  800    86   85  -               right,door
phase  3000    0    0   800  800    85   80  -               brake
